# Copy to .env for local development. Never commit a real key.
# In production these live in the Dokploy panel, on the server, and nowhere else.

# The team's Anthropic key. Without it the verdict route answers with canned lines and nothing breaks.
ANTHROPIC_API_KEY=

# The model that writes the line on the ticket.
VERDICT_MODEL=claude-haiku-5-5

# Kill switch. Set to false and every line is canned; the app keeps working.
VERDICT_ENABLED=true

# Lets the presenter clear the room board (POST /api/room/reset with header x-admin-token).
# At least 16 characters. Leave empty to disable the reset route.
ROOM_ADMIN_TOKEN=

# Optional.
PORT=3333
