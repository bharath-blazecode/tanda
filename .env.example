# Copy to .env for local development. Never commit a real key.
# In production these live in the Dokploy panel, on the server, and nowhere else.

# The team's Anthropic key. Without it the verdict route answers with canned lines and nothing breaks.
ANTHROPIC_API_KEY=

# The model that writes the line on the ticket.
VERDICT_MODEL=claude-haiku-5-5

# Kill switch. Set to false and every line is canned; the app keeps working.
VERDICT_ENABLED=true

# Paid call attempts per process per 24-hour window, 0..6000. Zero selects canned commentary.
# Configure a provider spending cap separately before allowing paid calls.
VERDICT_DAILY_CALL_LIMIT=0

# Comma-separated exact socket addresses of verified forwarding proxies. Leave empty by default.
TRUSTED_PROXY_IPS=

# Lets the presenter clear the room board (POST /api/room/reset with header x-admin-token).
# At least 16 characters. Leave empty to disable the reset route.
ROOM_ADMIN_TOKEN=

# Names on the projector: typed (default) shows the cleaned name each person types; generated ignores
# typed names and shows only the generated nicknames. The panic switch if the board gets vandalised.
ROOM_NAMES=typed

# Optional. Mirrors the room board to Redis so a restart or deploy keeps it. Contains a password: never log it.
# Leave empty to keep the board in memory only (local development and tests).
REDIS_URL=

# Optional.
PORT=3333
